{
  "schema_version": 1,
  "kind_hint": "lanyard_agent",
  "env": {
    "OPENAI_API_KEY": "sk-placeholder-openai-replace-me",
    "XAI_API_KEY": "sk-placeholder-xai-replace-me",
    "ANTHROPIC_API_KEY": "sk-placeholder-anthropic-unused",
    "LITELLM_MASTER_KEY": "sk-placeholder-litellm-master",
    "LANYARD_OAUTH_KEY": "REPLACE_ME_oauth_encryption_key_32B_min",
    "META_API_KEY": "sk-placeholder-meta-replace-me",
    "CORP_LLM_API_KEY": "sk-placeholder-corp-llm-replace-me",
    "OPENROUTER_API_KEY": "sk-placeholder-openrouter-unused",
    "GATEWAY_RELAY_SECRET": "REPLACE_ME_relay_secret",
    "FIRECRAWL_API_KEY": "fc-placeholder-firecrawl-unused",
    "X_BEARER_TOKEN": "x-placeholder-bearer-unused",
    "POOLSIDE_API_KEY": "sk-placeholder-poolside-replace-me"
  },
  "oauth": {
    "xai-grok": {
      "access_token": "oauth-placeholder-xai-grok-access",
      "refresh_token": "oauth-placeholder-xai-grok-refresh",
      "expires_at": "2026-12-31T00:00:00Z",
      "metadata": {
        "account_label": "REPLACE_ME_agent_super_heavy_label"
      }
    },
    "openai-codex": {
      "access_token": "oauth-placeholder-openai-codex-access",
      "refresh_token": "oauth-placeholder-openai-codex-refresh",
      "expires_at": "2026-12-31T00:00:00Z",
      "metadata": {
        "chatgpt_account_id": "REPLACE_ME_chatgpt_account_id"
      }
    }
  },
  "custom_providers": [
    {
      "id": "meta",
      "base_url": "https://api.llama.com/compat/v1",
      "api_key_env": "META_API_KEY",
      "default_model": "llama-3.1-405b",
      "models": [
        "llama-3.1-405b",
        "llama-3.1-70b"
      ]
    },
    {
      "id": "corp-proxy",
      "base_url": "https://llm.example.com/v1",
      "key_env": "CORP_LLM_API_KEY",
      "default_model": "default",
      "models": [
        "default"
      ]
    }
  ],
  "config_secret_overlay": {
    "providers": {
      "openai": {
        "key_env": "OPENAI_API_KEY"
      },
      "meta": {
        "base_url": "https://api.llama.com/compat/v1",
        "key_env": "META_API_KEY"
      },
      "corp-proxy": {
        "base_url": "https://llm.example.com/v1",
        "key_env": "CORP_LLM_API_KEY"
      }
    }
  },
  "files": [
    {
      "path_relative": "oauth.enc",
      "encoding": "base64",
      "content_base64": "REPLACE_ME_base64_oauth_enc_blob",
      "mode": "0600"
    }
  ],
  "meta": {
    "tenant_slug": "example-tenant",
    "notes": "Placeholder envelope for lanyard_agent BACKEND_HOME paths (OAuth store + LiteLLM multi-slot env + key_env providers). LiteLLM model_list seed: deploy/litellm/config.yaml (lp-645.8.5)."
  }
}
