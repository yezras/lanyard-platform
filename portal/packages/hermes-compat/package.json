{
  "name": "@lanyard/hermes-compat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hermes deployment compatibility: HERMES_* env aliases → BACKEND_*, /hermes/* endpoint deprecation notes, and removal criteria (lp-k7g.8.7).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
