{
  "name": "@lanyard/chat-corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChatTurnRecord v1 types, Zod write-boundary parse, CorpusWriter (fake + S3 put by turn_id) with metrics/retry/DLQ, training export list/read by tenant+time range, and content_sha256 helpers for L10 tenant chat corpus (plan 0011 / contracts/chat-corpus-v1).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "." : {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lanyard-chat-corpus-export": "./dist/cli/export-training.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:training": "node --import tsx src/cli/export-training.ts"
  },
  "dependencies": {
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
