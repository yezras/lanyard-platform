# /etc/company-brain/artifact-pins.env fragment — Hermes-Lanyard staging (lp-k7g.12.5)
#
# Primary keys are the long-term generic BACKEND_* contract consumed by
# deploy/scripts/bootstrap-backend-install.sh. HERMES_* dual-write is temporary
# for the migration window (same effective values).
#
# Replace PLACEHOLDER values only when wiring a private host overlay.
# Default coordinates match compatibility/pins.hermes-lanyard-staging.example.yaml.
# Never commit live account tokens. Private GH downloads need GITHUB_TOKEN/GH_TOKEN
# from env/SSM at bootstrap time — not in this file.
#
# Rendered by company-brain-ec2 user_data from backend_artifact_* locals;
# see modules/company-brain-ec2/user_data_backend_pins.fragment.tftpl.

# --- client-core (separate artifact; not swapped with backend kind) ---
CLIENT_CORE_ARTIFACT_URL=https://github.com/LanyardBrain/client-core/releases/download/v0.1.0-g7c2/client-core-v0.1.0-g7c2.tar.gz
CLIENT_CORE_ARTIFACT_VERSION=v0.1.0-g7c2
CLIENT_CORE_ARTIFACT_SHA256=ef21c313525afdca9902c40814293bbe924f428c219d93cf80398941c1f181e1

# --- primary backend pins (generic pipeline) ---
# Prefer arch-labeled S3 when mirrored, e.g.:
#   s3://$BUCKET/hermes/v0.1.0-g7h3/linux-x86_64/hermes-v0.1.0-g7h3.tar.gz
# BACKEND_ARTIFACT_ARCH must match the object (default product = linux-x86_64).
BACKEND_ARTIFACT_URL=https://github.com/LanyardBrain/hermes-lanyard/releases/download/v0.1.0-g7h3/hermes-v0.1.0-g7h3.tar.gz
BACKEND_ARTIFACT_VERSION=v0.1.0-g7h3
BACKEND_ARTIFACT_SHA256=a372580396e170436c22e44a61fbcdf8d2c7cf4f5d328694bb5afdf279904db9
BACKEND_ARTIFACT_KIND=hermes_lanyard
BACKEND_ARTIFACT_ARCH=linux-x86_64
BACKEND_ARTIFACT_SIGNATURE_B64=
BACKEND_CONTRACT_RUNTIME_LAYOUT=1
BACKEND_CONTRACT_RELAY=1
BACKEND_CONTRACT_BRAIN_RPC=1
BACKEND_INSTALL_PATH=/opt/company-brain-backend

# --- temporary legacy dual-write (migration window only; same values) ---
HERMES_ARTIFACT_URL=https://github.com/LanyardBrain/hermes-lanyard/releases/download/v0.1.0-g7h3/hermes-v0.1.0-g7h3.tar.gz
HERMES_ARTIFACT_VERSION=v0.1.0-g7h3
HERMES_ARTIFACT_SHA256=a372580396e170436c22e44a61fbcdf8d2c7cf4f5d328694bb5afdf279904db9
HERMES_ARTIFACT_ARCH=linux-x86_64
RELAY_CONTRACT_MAJOR=1
HERMES_INSTALL_PATH=/opt/company-brain-backend

VAULT_ROOT=/opt/company-brain
ENABLE_OMNIBOX=0
OMNIBOX_ENABLED=0
