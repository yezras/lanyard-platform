# Lab-only short-stack harness (lp-oop.30). Not for production.
# Copy to .env (gitignored) and chmod 0600. Never paste SM/SSM values.

# Optional compose image. Host-process path does not need this.
HARNESS_IMAGE=lanyard/harness:local

HARNESS_HOST_BIND=127.0.0.1
HARNESS_HOST_PORT=8080

# Lab-only / not-for-production placeholder. Production must use SM/SSM.
# Must match lab BFF HARNESS_SERVICE_TOKEN when exercising ChatDelivery=harness.
HARNESS_SERVICE_TOKEN=placeholder-harness-service-token

# Built lanyard-agent checkout for run-lab-harness.sh (host process).
# LANYARD_AGENT_ROOT=/absolute/path/to/lanyard-agent

# Writable harness home (kitchen-sink config.yaml + skills/workflows).
# run-lab-harness.sh materializes the vault seed here when unset.
# BACKEND_HOME=/tmp/lanyard-backend

# Toolbox process cwd on the Daytona guest. LA default is /mnt/vault
# (tool-only snapshot has no /workspace). Override only if the guest path differs.
# HARNESS_TOOLBOX_CWD=/mnt/vault

# Harness settings + MCP catalog (lp-oop.38.17). Image default is
# /var/lib/lanyard-backend. Start merges secret-free lab_echo into
# $BACKEND_HOME/config.yaml when /opt/lanyard/lab-mcp/lab_echo_server.py exists.
# BACKEND_HOME=/var/lib/lanyard-backend
# Optional. With CONTROL_PLANE_SERVICE_TOKEN, scheduled_task create writes
# vault cron/jobs.json via CP HTTP (lp-oop.38.16). Empty omits the tool.
# Lab-only names. Never paste SM/SSM values.
# CONTROL_PLANE_URL=http://127.0.0.1:8787
# CONTROL_PLANE_SERVICE_TOKEN=
# HTTP search/parse keys stay on this harness process (lp-oop.38.12).
# Never copy them onto Daytona tool_only create-env. Omit paid keys to use
# DuckDuckGo fallback; x_search registers only when XAI_API_KEY is live.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# XAI_API_KEY=
# Harness inventory home. Start wrapper seeds subagents.enabled here when omitted
# (lp-oop.38.14). Image default is /var/lib/lanyard-agent. Kitchen-sink overlay
# (lp-oop.38.18) at /var/lib/lanyard-backend is used when env is empty and that
# config.yaml already exists.
# BACKEND_HOME=/var/lib/lanyard-agent

# Image bake fails boot when spawn_subagent / memory_read are missing.
# Unset only for lab modules that deliberately omit those schemas.
# HARNESS_REQUIRE_SPAWN=1
# HARNESS_REQUIRE_MEMORY=1

# Kill switch for default-on memory_read (toolbox MemPalace). Unset = on.
# HARNESS_MEMPALACE_ENABLED=0
