{
  "family": "lanyard-platform-staging-harness",
  "_comment": "lp-oop.30 / lp-oop.37.4 / lp-oop.38.20 example only. Register on EXISTING cluster lanyard-platform-staging-portal-cp. executionRoleArn must be able to GetSecretValue on harness-service-token, harness-litellm, and daytona (dedicated harness-exec, or BFF exec extra ARNs while shared). Never commit live tokens. Not a new ECS cluster / ALB product. Not a Daytona snapshot. No plaintext XAI/DAYTONA/GATEWAY/LITELLM keys in environment[].",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT:role/REPLACE-harness-exec",
  "taskRoleArn": "arn:aws:iam::ACCOUNT:role/REPLACE-harness-task-logs-only",
  "containerDefinitions": [
    {
      "name": "harness",
      "image": "ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/lanyard-platform-staging/portal/harness@sha256:REPLACE_64_HEX_DIGEST",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "HARNESS_HOST", "value": "0.0.0.0" },
        { "name": "HARNESS_PORT", "value": "8080" },
        { "name": "BACKEND_HOME", "value": "/var/lib/lanyard-backend" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "BACKEND_HOME", "value": "/var/lib/lanyard-backend" },
        { "name": "BACKEND_HOME", "value": "/var/lib/lanyard-agent" },
        { "name": "LITELLM_BASE_URL", "value": "https://REPLACE-litellm-base" },
        { "name": "HARNESS_MODEL", "value": "REPLACE-harness-model" },
        { "name": "LANYARD_DEFAULT_MODEL", "value": "REPLACE-lanyard-default-model" },
        { "name": "CONTROL_PLANE_URL", "value": "http://REPLACE-internal-cp" }
      ],
      "secrets": [
        {
          "name": "HARNESS_SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/harness-service-token"
        },
        {
          "name": "LANYARD_HARNESS_SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/harness-service-token"
        },
        {
          "name": "CONTROL_PLANE_SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/control-plane-service-token"
        },
        {
          "name": "LITELLM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/harness-litellm:LITELLM_API_KEY::"
        },
        {
          "name": "LITELLM_MASTER_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/harness-litellm:LITELLM_MASTER_KEY::"
        },
        {
          "name": "DAYTONA_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/daytona:DAYTONA_API_KEY::"
        },
        {
          "name": "DAYTONA_ORG_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:lanyard/staging/portal/daytona:DAYTONA_ORG_ID::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('net').connect(8080,'127.0.0.1',()=>process.exit(0)).on('error',()=>process.exit(1))\""
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lanyard-platform-staging-harness",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "harness"
        }
      }
    }
  ]
}
