# Local Muse Spark / Meta Model API env for the LiteLLM provider client.
# Copy to ~/.lanyard-agent/meta.env and chmod 600. Never commit the copy.
#
# LiteLlmClient POSTs {baseUrl}/v1/chat/completions.
# LITELLM_BASE_URL must be https://api.meta.ai — not https://api.meta.ai/v1.
#
# lp-k5c4.17 — localhost harness only. Not a Portal/BFF gateway.

LITELLM_BASE_URL=https://api.meta.ai
LITELLM_API_KEY=sk-placeholder-meta-replace-me
HARNESS_MODEL=muse-spark-1.2-contributor

# Optional alias; serve-la.mjs copies this into LITELLM_API_KEY when unset.
# META_API_KEY=sk-placeholder-meta-replace-me
