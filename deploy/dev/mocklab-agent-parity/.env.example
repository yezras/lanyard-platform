# Lab-only placeholders — never commit real secrets or .env.mocklab-agent-dev.
# Copy to a private .env (gitignored) when using docker compose.

POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_cp

CONTROL_PLANE_SERVICE_TOKEN=placeholder-control-plane-service-token
RELAY_INTERNAL_TOKEN=placeholder-relay-internal-token

# JSON array: [{gatewayId, instanceId, secret, tenantId}]
# Must match Lanyard Agent GATEWAY_RELAY_* env.
RELAY_DEV_SECRETS=[]

BRAIN_RPC_ENABLED=1
DEV_TENANT_SLUG=demo

# Host vault for Office samples / Directory (bind-mount into BFF if containerized)
# VAULT_ROOT=/path/to/vault

# Optional LA pin when image is published by agent track
# LANYARD_AGENT_IMAGE=ghcr.io/example/lanyard-agent:pin
# LANYARD_AGENT_BACKEND_HOME=/var/lib/lanyard-agent
