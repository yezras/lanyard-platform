# Lab-only environment for `lab-shared-compose-ds` (lp-5q6.25).
# Copy to `.env` (gitignored) before `docker compose up`.
# NEVER put production Secrets Manager values or customer vault paths here.

# --- JWT (required; lab-only known secret) ---
# BFF document-config signer must use the same secret when Office bridge lands (lp-5q6.21+).
JWT_ENABLED=true
JWT_SECRET=lab-jwt-secret-placeholder
JWT_HEADER=Authorization
JWT_IN_BODY=true

# --- Browser-facing publish ---
# Loopback-only by default so lab DS is not advertised on LAN interfaces.
DS_HOST_BIND=127.0.0.1
DS_HOST_PORT=8080

# --- Image pin (optional) ---
# Example: ONLYOFFICE_DS_TAG=8.3.1
ONLYOFFICE_DS_TAG=latest

# --- Soft resource caps (docker compose deploy.resources; ignored by some engines) ---
DS_CPUS=2.0
DS_MEMORY=4G

# --- Reachability helpers for BFF URLs minted by the lab BFF ---
# Document Server container reaches the host via host.docker.internal (extra_hosts in compose).
# When minting document.url / callbackUrl for the editor config, use the host gateway, e.g.:
#   LAB_BFF_PUBLIC_BASE_URL=http://host.docker.internal:4000
# Browser still talks to BFF on http://127.0.0.1:4000 (or your local portal URL).
# ALLOW_PRIVATE_IP_* lets DS fetch those private-range signed download URLs in lab.
ALLOW_PRIVATE_IP_ADDRESS=true
ALLOW_META_IP_ADDRESS=true

# Optional convenience vars for integrators / smoke notes (not consumed by compose itself):
LAB_DS_PUBLIC_URL=http://127.0.0.1:8080
LAB_BFF_PUBLIC_BASE_URL=http://host.docker.internal:4000
LAB_BFF_BROWSER_BASE_URL=http://127.0.0.1:4000
