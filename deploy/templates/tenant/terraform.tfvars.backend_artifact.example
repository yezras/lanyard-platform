# backend_artifact_arch    = "linux-x86_64"
# backend_artifact_url     = "s3://example-artifacts-bucket/backends/hermes-lanyard/v0.1.0-g7h2/linux-x86_64/backend.tar.gz"
# # or product hermes/ prefix (same arch segment):
