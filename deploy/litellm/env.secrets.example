# Full multi-slot env placeholder set for Lanyard Agent + LiteLLM (lp-645.8.5)
#
# Git / docs only. Values are obvious non-secrets.
# Live SM (BackendRuntimeSecretsEnvelope.env) MUST omit unused slots and never
# ship sentinels that look live. Materialize writes active keys to:
#   $BACKEND_HOME/.env.secrets   (mode 0600)
#
# Both company-brain-backend (agent) and lanyard-litellm units should include:
#   EnvironmentFile=-$BACKEND_HOME/.env.secrets
#
# Companion LiteLLM model_list: deploy/litellm/config.yaml
# Envelope examples:
#   contracts/backend-runtime-v1/examples/secrets-envelope.lanyard-agent.json
#   contracts/backend-runtime-v1/examples/secrets-envelope.full-matrix.json

# --- API keys (LiteLLM model_list api_key: os.environ/<NAME>) ---
OPENAI_API_KEY=sk-placeholder-openai-replace-me
XAI_API_KEY=sk-placeholder-xai-replace-me
ANTHROPIC_API_KEY=sk-placeholder-anthropic-unused
OPENROUTER_API_KEY=sk-placeholder-openrouter-unused

# --- Custom OpenAI-compatible providers (model_list api_base + api_key env) ---
META_API_KEY=sk-placeholder-meta-replace-me
CORP_LLM_API_KEY=sk-placeholder-corp-llm-replace-me
# Poolside: https://inference.poolside.ai/v1  model poolside/laguna-s-2.1
POOLSIDE_API_KEY=sk-placeholder-poolside-replace-me

# --- LiteLLM proxy master key (Agent ↔ proxy Bearer; NOT a model provider key) ---
LITELLM_MASTER_KEY=sk-placeholder-litellm-master

# --- Agent OAuthStore encryption key (pairs with $BACKEND_HOME/oauth.enc) ---
# Generate offline; store with the oauth.enc blob in SM. Min 32 bytes recommended.
LANYARD_OAUTH_KEY=REPLACE_ME_oauth_encryption_key_32B_min

# Optional override for OAuth store path (default: $BACKEND_HOME/oauth.enc)
# LANYARD_OAUTH_STORE=/var/lib/lanyard-agent/backend-home/oauth.enc

# --- Relay / host (non-model; often co-materialized) ---
GATEWAY_RELAY_SECRET=REPLACE_ME_relay_secret

# --- Agent web search / crawl (lp-uxy.7) + parse_document OCR (lp-uxy.10 F5) — COST-GATED ---
# Omit from live SM until intentionally enabling that provider.
# Never commit real keys. Portal UI works from fixture/mock without these.
# Never put this key on Portal BFF — host agent secrets envelope only.
# Firecrawl: paid crawl/scrape/extract AND optional scanned-PDF Parse OCR
# (parse_document force_ocr / auto_ocr when PARSE_DOCUMENT_ALLOW_OCR=true).
# Do not enable without budget sign-off. Placeholders never open live calls.
FIRECRAWL_API_KEY=fc-placeholder-firecrawl-unused
# Optional host flags for parse_document OCR (default off; set on agent host only):
# PARSE_DOCUMENT_ALLOW_OCR=false
# PARSE_DOCUMENT_AUTO_OCR=false
# Optional X (Twitter) API bearer for x_search tool
X_BEARER_TOKEN=x-placeholder-bearer-unused
# Optional SERP providers (host tools; not required for Portal citation UI)
TAVILY_API_KEY=tvly-placeholder-tavily-unused
BRAVE_API_KEY=BSA-placeholder-brave-unused
