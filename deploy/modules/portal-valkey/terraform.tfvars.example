# Documentation-only example inputs for modules/portal-valkey.
# Copy to a *private* terraform.tfvars (never commit live values, auth tokens, or real account IDs).
# This module is NOT auto-applied from git examples. Status: infra_ready, not production certified.
#
# Prerequisites (product):
#   - G5: BFF shared state (REDIS_URL / BFF_SESSION_BACKEND=redis) before desired_count > 1
#   - G6: relay bus / jti sharing via REDIS_URL before relay desired_count > 1
#
# Prerequisites (AWS operator):
#   - VPC with ≥2 private subnets (map_public_ip_on_launch=false)
#   - Security group(s) for private BFF and/or relay tasks (never 0.0.0.0/0)
#   - AWS credentials / backend configured outside this repository

name_prefix = "lanyard-portal-staging"
environment = "staging"

# Replace with real IDs from *your* account (examples below are RFC-style shapes only — not live).
# Do not invent production account numbers in committed files.
vpc_id = "vpc-00000000000000000"
subnet_ids = [
  "subnet-00000000000000001",
  "subnet-00000000000000002",
]

# Prefer SG-based access from private BFF + relay tasks.
allowed_security_group_ids = [
  "sg-00000000000000001", # BFF task SG (placeholder)
  "sg-00000000000000002", # relay task SG (placeholder)
]
# Optional private CIDRs only — 0.0.0.0/0 and ::/0 are rejected:
# allowed_cidr_blocks = ["10.0.0.0/16"]

# Engine / size (default: smallest production-credible HA pair)
engine               = "valkey"
engine_version       = "8.0"
node_type            = "cache.t4g.micro"
num_cache_clusters   = 2
multi_az_enabled     = true
automatic_failover_enabled = true

# Staging cost path (single node, no HA) — uncomment and set HA false:
# num_cache_clusters         = 1
# multi_az_enabled           = false
# automatic_failover_enabled = false

# Encryption always on (must stay true / omit).
transit_encryption_enabled = true
at_rest_encryption_enabled = true
# Optional CMK:
# kms_key_id = "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY-ID"

snapshot_retention_limit = 7
# snapshot_window    = "07:00-08:00"
# maintenance_window = "sun:08:00-sun:09:00"

enable_slow_log          = true
enable_engine_log        = false
create_cloudwatch_alarms = true
# alarm_sns_topic_arns   = ["arn:aws:sns:REGION:ACCOUNT_ID:topic-name"]

# Secrets: auth token is generated by Terraform and stored in Secrets Manager.
# Never put auth tokens or REDIS_URL passwords in this file.
# redis_url_secret_name = "lanyard-portal-staging/portal/redis-url"
create_ssm_parameter_pointer = true
# ssm_parameter_name = "/company-brain/lanyard-portal-staging/portal-redis-url-secret-arn"

# Required honesty gate
acknowledge_not_auto_applied = true

tags = {
  Owner = "platform"
}
