# Documentation-only example inputs for modules/control-plane-rds.
# Copy to a *private* terraform.tfvars (never commit live values, passwords, or real account IDs).
# This module is NOT auto-applied from git examples.
#
# Prerequisites (product):
#   - G4.1: control plane uses CONTROL_PLANE_DATABASE_URL / DATABASE_URL (Postgres)
#   - G4.2: migration/rollback story accepted
#
# Prerequisites (AWS operator):
#   - VPC with ≥2 private subnets (map_public_ip_on_launch=false)
#   - Security group(s) for private control-plane consumers (or private CIDRs — never 0.0.0.0/0)
#   - AWS credentials / backend configured outside this repository

name_prefix  = "lanyard-cp-staging"
environment  = "staging"

# Replace with real IDs from *your* account (examples below are RFC-style shapes only — not live).
# Do not invent production account numbers in committed files.
vpc_id = "vpc-00000000000000000"
subnet_ids = [
  "subnet-00000000000000001",
  "subnet-00000000000000002",
]

# Public RDS is rejected (must stay false / omit).
publicly_accessible = false

# Prefer SG-based access from private control-plane tasks.
allowed_security_group_ids = [
  "sg-00000000000000001",
]
# Optional private CIDRs only — 0.0.0.0/0 and ::/0 are rejected:
# allowed_cidr_blocks = ["10.0.0.0/16"]

# Engine / size — module example stays production-credible HA.
# Staging pilot cost path lives in environments/platform-staging (db.t4g.small, 20 GiB, multi_az=false).
# For a lean standalone staging apply, override in private tfvars:
#   instance_class = "db.t4g.small"; allocated_storage = 20; multi_az = false
engine_version    = "16.6"
instance_class    = "db.t4g.medium"
allocated_storage = 50
multi_az          = true
db_name           = "control_plane"
master_username   = "cp_admin"

# Encryption always on. Optional CMK:
# kms_key_id = "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY-ID"

backup_retention_period = 7
deletion_protection     = true
skip_final_snapshot     = false

# Secrets: password is generated by Terraform and stored in Secrets Manager.
# Never put passwords in this file.
# database_url_secret_name = "lanyard-cp-staging/control-plane/database-url"
create_ssm_parameter_pointer = true
# ssm_parameter_name = "/company-brain/lanyard-cp-staging/control-plane-database-url-secret-arn"

# Required honesty gate
acknowledge_not_auto_applied = true

tags = {
  Owner = "platform"
}
