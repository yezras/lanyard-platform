# Lanyard Portal relay wiring — generated by customer-gateway-relay Terraform module.
# Merge into ~/.hermes/.env (or source from systemd EnvironmentFile).
# Tenant: ${tenant_slug}
# Generated: ${generated_at_utc}
# Secret source: ${secret_source}
#
# Hermes precedence: GATEWAY_RELAY_* env vars override gateway.* in config.yaml.
# Contract: https://github.com/NousResearch/hermes-agent/blob/main/docs/relay-connector-contract.md
#
# Production: this file MUST NOT contain GATEWAY_RELAY_SECRET. Fetch on the host:
#   ${host_secret_fetch_command}

GATEWAY_RELAY_URL=${relay_url}
GATEWAY_RELAY_ID=${relay_instance_id}
GATEWAY_RELAY_INSTANCE_ID=${relay_instance_id}
GATEWAY_RELAY_PLATFORMS=${relay_platform}
%{ if secret_source == "ssm" ~}
# Reference only — not a Hermes-native key; host fetch writes GATEWAY_RELAY_SECRET.
GATEWAY_RELAY_SECRET_SSM_PARAMETER=${ssm_parameter_name}
%{ endif ~}
%{ if secret_source == "secretsmanager" ~}
# Reference only — not a Hermes-native key; host fetch writes GATEWAY_RELAY_SECRET.
GATEWAY_RELAY_SECRET_SECRETS_MANAGER_ARN=${secretsmanager_secret_arn}
%{ endif ~}
%{ if include_secret ~}
# LAB ONLY — plaintext secret in working tree. Forbidden in production.
GATEWAY_RELAY_SECRET=${relay_secret}
%{ endif ~}
