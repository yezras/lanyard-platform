# Reference fragment for /etc/company-brain/artifact-pins.env (lp-k7g.7.3 / lp-k7g.10.3).
# MERGED into user_data.sh.tftpl — keep this file as the dual-write contract checklist.
#
# templatefile() args (main.tf) pass effective locals from backend_artifact_locals.tf:
#   backend_artifact_url, backend_artifact_version, backend_artifact_sha256,
#   backend_artifact_kind, backend_artifact_arch, backend_contract_runtime_layout,
#   backend_contract_relay, backend_contract_brain_rpc, backend_install_path,
#   backend_artifact_signature_b64
#   (+ client_core_* and install_path unchanged; enable_omnibox for omnibox flags)
# backend_artifact_arch default: linux-x86_64 (pins: backend.arch / hermes.target_arch)
#
# Primary BACKEND_* keys are the long-term contract (bootstrap-backend-install.sh).
# HERMES_* / RELAY_CONTRACT_MAJOR are TEMPORARY dual-write aliases.
# BACKEND_INSTALL_PATH should be the versioned root (/opt/company-brain-backend);
# see docs/architecture/deploy-bootstrap-backend-install.md (lp-k7g.7.4).

# Generated by company-brain-ec2 user_data — replace UNCONFIGURED before bootstrap.
CLIENT_CORE_ARTIFACT_URL=${client_core_artifact_url}
CLIENT_CORE_ARTIFACT_VERSION=${client_core_artifact_version}
CLIENT_CORE_ARTIFACT_SHA256=${client_core_artifact_sha256}

# Primary backend artifact pins (generic; any backend.kind)
BACKEND_ARTIFACT_URL=${backend_artifact_url}
BACKEND_ARTIFACT_VERSION=${backend_artifact_version}
BACKEND_ARTIFACT_SHA256=${backend_artifact_sha256}
BACKEND_ARTIFACT_KIND=${backend_artifact_kind}
BACKEND_ARTIFACT_ARCH=${backend_artifact_arch}
BACKEND_ARTIFACT_SIGNATURE_B64=${backend_artifact_signature_b64}
BACKEND_CONTRACT_RUNTIME_LAYOUT=${backend_contract_runtime_layout}
BACKEND_CONTRACT_RELAY=${backend_contract_relay}
BACKEND_CONTRACT_BRAIN_RPC=${backend_contract_brain_rpc}
BACKEND_INSTALL_PATH=${backend_install_path}

# TEMPORARY legacy aliases (same effective values — remove after bootstrap cutover)
HERMES_ARTIFACT_URL=${backend_artifact_url}
HERMES_ARTIFACT_VERSION=${backend_artifact_version}
HERMES_ARTIFACT_SHA256=${backend_artifact_sha256}
HERMES_ARTIFACT_ARCH=${backend_artifact_arch}
RELAY_CONTRACT_MAJOR=${backend_contract_relay}
HERMES_INSTALL_PATH=${backend_install_path}

VAULT_ROOT=${install_path}
ENABLE_OMNIBOX=${enable_omnibox ? "1" : "0"}
OMNIBOX_ENABLED=${enable_omnibox ? "1" : "0"}
