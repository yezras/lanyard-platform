# ---------------------------------------------------------------------------
# Backend runtime secrets (lp-645.4) — ARN reference only; values stay in SM.
# Appended by company-brain-ec2 when backend_runtime_secrets_arn is set.
#
# Size budget: do NOT embed materialize-backend-secrets.py here (outer base64gzip
# user_data must stay ≤16 KiB with bootstrap inject). Tool install is owned by
# setup.sh / ensure-runtime-hardening.sh (monorepo deploy/scripts path).
# ---------------------------------------------------------------------------
echo "[company-brain-user-data] Configuring backend runtime secrets materialize (ARN only)"

mkdir -p /etc/company-brain

# Non-secret host config: ARN + region only — NEVER secret values.
# Mode 0644: references only (not secrets); service users must source this for ExecStartPre.
# BACKEND_HOME / HERMES_HOME come from the systemd unit Environment= (not overridden here).
cat >/etc/company-brain/backend-runtime-secrets.env <<'SECRETSENV'
# Generated by company-brain-ec2 user_data — references only (no secret values).
BACKEND_RUNTIME_SECRETS_ARN=${backend_runtime_secrets_arn}
AWS_REGION=${backend_runtime_secrets_region}
AWS_DEFAULT_REGION=${backend_runtime_secrets_region}
SECRETSENV
chmod 0644 /etc/company-brain/backend-runtime-secrets.env

# Non-secret model defaults (provider/model id only — not API keys).
cat >/etc/company-brain/backend-model-defaults.env <<'MODELENV'
# Non-secret model defaults from Terraform (backend_model_provider / backend_model_default).
BACKEND_MODEL_PROVIDER=${backend_model_provider}
BACKEND_MODEL_DEFAULT=${backend_model_default}
MODELENV
chmod 0644 /etc/company-brain/backend-model-defaults.env

# Seed non-secret model.provider / model.default into config.yaml when missing.
# Does not overwrite operator customizations; does not write secret keys.
BACKEND_HOME_DIR='${backend_home}'
mkdir -p "$BACKEND_HOME_DIR"
PROVIDER='${backend_model_provider}'
MODEL='${backend_model_default}'
if [[ -n "$PROVIDER" || -n "$MODEL" ]]; then
  CFG="$BACKEND_HOME_DIR/config.yaml"
  if [[ ! -f "$CFG" ]]; then
    {
      echo "# Seeded by company-brain-ec2 user_data (non-secret model defaults only)"
      echo "model:"
      if [[ -n "$PROVIDER" ]]; then
        echo "  provider: $PROVIDER"
      fi
      if [[ -n "$MODEL" ]]; then
        echo "  default: $MODEL"
      fi
    } >"$CFG"
    chmod 0600 "$CFG"
    echo "[company-brain-user-data] Seeded non-secret model defaults into $CFG"
  else
    # Only add missing model.provider / model.default keys (idempotent; no overwrite).
    python3 - "$CFG" "$PROVIDER" "$MODEL" <<'PY' || echo "[company-brain-user-data] WARNING: model default seed skipped" >&2
import sys
from pathlib import Path
path, provider, model = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = path.read_text(encoding="utf-8")
# Skip if a model: block already exists (operator may have customized).
if "\nmodel:" in text or text.startswith("model:"):
    sys.exit(0)
lines = ["", "# Non-secret model defaults (company-brain-ec2; secrets stay in SM)", "model:"]
if provider:
    lines.append(f"  provider: {provider}")
if model:
    lines.append(f"  default: {model}")
path.write_text(text.rstrip() + "\n" + "\n".join(lines) + "\n", encoding="utf-8")
PY
  fi
fi

# Materialize tool is installed by setup.sh / ensure-runtime-hardening (not embedded
# in user_data — keeps EC2 user_data ≤16 KiB with bootstrap). Best-effort call if
# already present (re-bootstrap / golden AMI with tools preinstalled).
# systemd ExecStartPre re-runs materialize before gateway start (rotation-friendly).
if [[ -x /usr/local/sbin/materialize-backend-secrets ]]; then
  if /usr/local/sbin/materialize-backend-secrets; then
    echo "[company-brain-user-data] Backend runtime secrets materialize finished (or no-op)"
  else
    echo "[company-brain-user-data] WARNING: materialize failed at first boot — fix IAM/secret/envelope and re-run: sudo /usr/local/sbin/materialize-backend-secrets" >&2
  fi
else
  echo "[company-brain-user-data] materialize tool not on disk yet — install via setup.sh / ensure-runtime-hardening, then: sudo /usr/local/sbin/materialize-backend-secrets"
fi
