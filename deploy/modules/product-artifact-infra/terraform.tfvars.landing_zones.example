#     s3_write_prefix_keys = ["portal_web"]
#     ecr_push_services    = ["web", "bff", "relay", "control-plane"]
#   }
#   client_core = {
#     repository           = "client-core"
#     s3_write_prefix_keys = ["client_core"]
#     ecr_push_services    = []
#   }
#   hermes_lanyard = {
#     repository           = "hermes-lanyard"
#     s3_write_prefix_keys = ["hermes_lanyard", "hermes"]
#     ecr_push_services    = []
#   }
#   lanyard_agent = {
#     repository           = "lanyard-agent"
#     s3_write_prefix_keys = ["lanyard_agent"]
#     ecr_push_services    = []
#   }
# }

# Illustrative pin URLs after publish (operators fill real SHA-256).
# Default product arch = linux-x86_64 (backend.arch / backend_artifact_arch).
#   s3://…/backends/hermes-lanyard/v0.1.0-g7h2/linux-x86_64/backend.tar.gz
#   s3://…/hermes/v0.1.0-g7h2/linux-x86_64/hermes-v0.1.0-g7h2.tar.gz
