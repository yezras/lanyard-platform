# ---------------------------------------------------------------------------
# product-artifact-infra — landing zone inputs example (lp-k7g.7.6)
#
# Placeholder-safe for git. Use with the imported module at phase 6; do not
# invent live account IDs, bucket names you need secret, or OIDC ARNs in git.
#
# Design: docs/architecture/deploy-artifact-landing-zones.md
# ---------------------------------------------------------------------------

name_prefix          = "lanyard-platform-staging"
environment          = "staging"
artifact_bucket_name = "lanyard-product-artifacts-staging-REPLACE"

# Target multi-backend prefixes (client-core + portal-web UNCHANGED).
artifact_prefixes = {
  hermes_lanyard  = "backends/hermes-lanyard/"
  lanyard_agent   = "backends/lanyard-agent/"
  hermes_upstream = "backends/hermes-upstream/"
  client_core     = "client-core/"
  portal_web      = "portal-web/"
  hermes          = "hermes/" # TEMPORARY dual-write for Hermes-Lanyard
}

portal_services = ["web", "bff", "relay", "control-plane"]

# OIDC publishers off until an existing provider ARN is supplied.
enable_oidc_publishers = false
# github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
# enable_oidc_publishers  = true

# Target publisher map (when enable_oidc_publishers = true):
