{
  "_comment": "TEMPLATE lp-gkh.3 — IAM policy for L10 chat corpus writer (CorpusWriter). Substitute ${LANYARD_CHAT_CORPUS_BUCKET}. Allow PutObject only under tenants/*/chat-corpus/v1/*; Deny vault paths. Do not commit secrets; apply via deploy/modules/chat-corpus-infra. Offline smoke: deploy/scripts/smoke-chat-corpus-infra.sh",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCorpusPrefixesOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::${LANYARD_CHAT_CORPUS_BUCKET}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tenants/",
            "tenants/*",
            "tenants/*/chat-corpus/",
            "tenants/*/chat-corpus/*",
            "tenants/*/chat-corpus/v1/",
            "tenants/*/chat-corpus/v1/*"
          ]
        }
      }
    },
    {
      "Sid": "PutCorpusObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${LANYARD_CHAT_CORPUS_BUCKET}/tenants/*/chat-corpus/v1/*"
    },
    {
      "Sid": "DenyVaultPathsBlastRadius",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::*/tenants/*/vault",
        "arn:aws:s3:::*/tenants/*/vault/*",
        "arn:aws:s3:::${LANYARD_CHAT_CORPUS_BUCKET}/tenants/*/vault",
        "arn:aws:s3:::${LANYARD_CHAT_CORPUS_BUCKET}/tenants/*/vault/*"
      ]
    },
    {
      "Sid": "DenyListVaultPrefixOnCorpusBucket",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::${LANYARD_CHAT_CORPUS_BUCKET}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tenants/*/vault",
            "tenants/*/vault/",
            "tenants/*/vault/*"
          ]
        }
      }
    }
  ]
}
